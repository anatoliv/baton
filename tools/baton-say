#!/bin/zsh
# baton-say — speak a line through a running Baton.
#
# A thin JSON-RPC client for Baton's existing MCP server. There is no new server surface here:
# BatonMCPServer already serves POST /mcp on 127.0.0.1 behind a bearer token, and the `prepare`
# argument makes the *app* clean the text — stripping ANSI, shell prompts and anything shaped
# like a credential — rather than trusting a shell script to do it.
#
#   baton-say "deploy finished"
#   some-command 2>&1 | tail -20 | baton-say --stdin --category ops
#
# Options:
#   --stdin              read the line from standard input instead of the arguments
#   --category NAME      voice category (ops, deploy, alert, …)
#   --session NAME       who is speaking; Baton shows it above the line (it is not spoken)
#   --mode MODE          notify (default) | banner | auto
#   --prepare PROFILE    terminal | browser | generic  (default: terminal for --stdin)
#   --timeout SECONDS    request ceiling (default 3; a cold speech service can need longer)
#   --verbose            report the outcome, or the failure, instead of exiting quietly
#
# Exits 0 even when Baton is not running, unless --verbose. This is called from a shell prompt
# hook: a tool that complains at every prompt because an app is closed is worse than no tool.
#
# The line travels on standard input to the request builder and then in the HTTP body only:
# never in an environment variable, and with --stdin never in any process's arguments
# An HTTP 200 is not taken as delivery: a JSON-RPC error or an MCP isError
# result is a failure, and --verbose prints what Baton reports it did (speaking, queued,
# notified, banner_shown). "speaking" means playback started, not that it was heard.

emulate -L zsh
setopt pipefail

endpoint_file="$HOME/Library/Application Support/Baton/mcp.json"
category=""; session="shell"; mode="notify"; prepare=""; verbose=0; use_stdin=0; text=""; timeout=3

while (( $# )); do
  case "$1" in
    --stdin) use_stdin=1; shift ;;
    --category) category="$2"; shift 2 ;;
    --session) session="$2"; shift 2 ;;
    --mode) mode="$2"; shift 2 ;;
    --prepare) prepare="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    --verbose) verbose=1; shift ;;
    -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
    *) text="${text:+$text }$1"; shift ;;
  esac
done

fail() { (( verbose )) && print -u2 "baton-say: $1"; exit $(( verbose ? 1 : 0 )); }

(( use_stdin )) && [[ -z "$prepare" ]] && prepare="terminal"
(( use_stdin )) || [[ -n "${text//[[:space:]]/}" ]] || fail "nothing to say"
[[ "$timeout" == <1-60> ]] || fail "--timeout takes whole seconds, 1 to 60"

# Discover the endpoint. Never hardcode the port: the server scans upward from its default when
# the port is busy, so a hardcoded 8787 works right up until the day it silently does not.
[[ -r "$endpoint_file" ]] || fail "Baton does not appear to be running (no mcp.json)"

command -v python3 >/dev/null 2>&1 || fail "python3 is required to build the request"

read -r -d '' program <<'PY'
import json, os, sys, urllib.request, urllib.error

verbose = os.environ["BATON_SAY_VERBOSE"] == "1"
def die(msg):
    if verbose:
        print("baton-say: " + msg, file=sys.stderr)
    sys.exit(1 if verbose else 0)

text = sys.stdin.read()
if not text.strip():
    die("nothing to say")
try:
    info = json.load(open(os.environ["BATON_SAY_ENDPOINT_FILE"]))
    url, token = info["url"], info["token"]
except Exception:
    die("could not read the endpoint file")

args = {"text": text, "mode": os.environ["BATON_SAY_MODE"]}
for key, env in (("category", "BATON_SAY_CATEGORY"), ("session", "BATON_SAY_SESSION"), ("prepare", "BATON_SAY_PREPARE")):
    if os.environ.get(env):
        args[key] = os.environ[env]

body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
                   "params": {"name": "speak_summary", "arguments": args}}).encode()
req = urllib.request.Request(url, data=body, headers={
    "Content-Type": "application/json",
    "Accept": "application/json, text/event-stream",
    "Authorization": "Bearer " + token,
})
try:
    # Hard ceiling. This runs from a shell prompt; it must never be the reason a prompt hangs.
    # A timeout is not proof of failure: Baton may still speak, so it is reported as uncertain.
    with urllib.request.urlopen(req, timeout=int(os.environ["BATON_SAY_TIMEOUT"])) as r:
        payload = r.read(65536).decode("utf-8", "replace")
except urllib.error.HTTPError as e:
    die("Baton answered HTTP %d" % e.code)
except urllib.error.URLError as e:
    if isinstance(e.reason, ConnectionRefusedError):
        die("could not reach Baton (connection refused)")
    die("delivery uncertain (%s)" % type(e.reason).__name__)
except TimeoutError:
    die("delivery uncertain (timed out)")
except Exception as e:
    die("request failed (%s)" % type(e).__name__)

try:
    if not payload.lstrip().startswith("{"):  # an event stream, possibly led by "event:" lines
        events = [json.loads(l[5:]) for l in payload.splitlines() if l.startswith("data:") and l[5:].strip() not in ("", "[DONE]")]
        reply = next((e for e in events if "result" in e or "error" in e), {})
    else:
        reply = json.loads(payload)
except ValueError:
    die("Baton returned an unreadable response")
if "error" in reply:
    die("Baton rejected the request (JSON-RPC error)")
result = reply.get("result") or {}
if result.get("isError"):
    die("speak_summary reported an error")
delivered = []
for block in result.get("content") or []:
    if block.get("type") == "text":
        try:
            status = json.loads(block.get("text") or "")
        except ValueError:
            continue
        if not isinstance(status, dict):
            continue
        delivered = status.get("delivered") or [status.get("status")]
if not any(delivered):
    die("Baton's reply did not say what it delivered")
if verbose:
    print(" ".join(d for d in delivered if d))
PY

if (( use_stdin )); then
  input_cmd=(cat)
else
  input_cmd=(print -rn -- "$text")
fi
"${input_cmd[@]}" | BATON_SAY_CATEGORY="$category" BATON_SAY_SESSION="$session" BATON_SAY_MODE="$mode" \
  BATON_SAY_PREPARE="$prepare" BATON_SAY_ENDPOINT_FILE="$endpoint_file" BATON_SAY_VERBOSE="$verbose" \
  BATON_SAY_TIMEOUT="$timeout" python3 -c "$program"
