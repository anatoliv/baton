.DS_Store
build/
dist/
DerivedData/
*.xcodeproj
.claude/worktrees/
app/Info.plist
# Local Sentry DSN override (the base xcconfig + .example are committed; the
# real DSN lives here and must never be committed or mirrored).
app/Config/Sentry.local.xcconfig
ios/Config/Sentry.local.xcconfig
website/appcast.xml

# Playwright CLI session artifacts — page snapshots capture whatever is on screen,
# including secrets from a portal. Never commit them.
.playwright-cli/
# SwiftPM build products, wherever they appear — Packages/, gateway/, and the
# Linux .build/ a container leaves behind after a cross-platform check.
.build/

# TestFlight secrets (see ios/scripts/.testflight.env.example)
ios/scripts/.testflight.env
ios/build/

# Bundled copies of the canonical guides, synced on every build.
ios/Resources/HELP.md
ios/Resources/FAQ.md

# Demo audio source material. Not shipped and not needed to build: the bundled
# m4a files are the deliverable, and CREDITS.md records where these came from.
ios/DemoSource/

# Python bytecode from the demo-audio scripts
__pycache__/
*.pyc

# Generated code-knowledge-graph output (86 MB and growing). Regenerated on demand by
# graphify, so it is derived, not source. It was ignored only via .git/info/exclude,
# which is local to one checkout and not version-controlled — a fresh clone anywhere
# else had nothing stopping `git add -A` from committing the whole thing.
graphify-out/
graphify-out-*/
.graphifyignore
