<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight distribution for Baton iOS, for a manual
	     export from an archive:
	       xcodebuild -exportArchive -archivePath build/Baton.xcarchive \
	         -exportPath build/export -exportOptionsPlist ExportOptions.plist
	     scripts/testflight.sh writes its own manually-signed variant and does
	     the upload; this file is the simple automatic-signing path for an
	     Xcode Organizer style export. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>Q8822GNL2H</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
