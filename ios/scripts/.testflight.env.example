# Copy to .testflight.env (gitignored) and fill in. Never commit the real file.
#
#   cp scripts/.testflight.env.example scripts/.testflight.env
#
# P12_PASSWORD — password for the Apple Distribution .p12 at
#   ~/.appstoreconnect/keepfloat_dist.p12 (one distribution cert per team, shared
#   across the team's apps; the filename is historical).
P12_PASSWORD=

# ASC_ISSUER_ID — App Store Connect API issuer UUID
#   (App Store Connect → Users and Access → Integrations → App Store Connect API).
ASC_ISSUER_ID=

# Required for publication. The issued baton-ios upload-only document (not the
# runtime DSN), mode 0600, kept OUTSIDE every checkout. The in-tree default
# ios/Config/CrashboxArtifactUpload.local.json still works but is not where it belongs.
# CRASHBOX_ARTIFACT_CREDENTIAL_FILE=/absolute/path/outside/the/checkout/credential.json

# Internal TestFlight migration canary only. Leave this off for every App Store
# candidate. The canary also requires the reporting and artifact inputs above.
# ENABLE_CRASH_CANARY=1

# Crash symbolication needs nothing else in this file. testflight.sh keeps the
# dSYM under dist/dsym/ and uploads it to Crashbox with the artifact credential
# above. A retained dSYM that was never uploaded can be sent later, from the
# repository root, with
#   ./scripts/upload-dsym.sh <archive> baton-ios
